RewriteEngine On
RewriteBase /dpwl-2522500007/

# Pengecualian agar folder aset bisa diakses langsung oleh browser tanpa lewat router
RewriteRule ^(assets|asse|uploads|dist)($|/) - [L]

# Jangan meneruskan berkas atau direktori fisik ke Router.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Teruskan URL aplikasi ke front controller.
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]